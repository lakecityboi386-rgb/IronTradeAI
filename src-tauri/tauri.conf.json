{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IronTrade AI NightShift",
  "version": "0.1.0",
  "identifier": "ai.irontrade.nightshift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IronTrade AI \u2014 NightShift",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; worker-src blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/nightshift-engine"],
    "icon": ["icons/icon.ico"]
  }
}
